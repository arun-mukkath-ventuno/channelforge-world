+def _httpx_transport(method: str, path: str, json: dict | None) -> tuple[int, dict]:
+    response = httpx.request(method, path, json=json, timeout=5.0)
+    try:
+        body = response.json()
+    except ValueError:
+        body = {}
+    return response.status_code, body
+
+
+def get_configured_ssai_adapter() -> SSAIAdapter:
+    """Ecosystem-world glue (channelforge-world/world/patches): construct the real
+    ssai_adserver adapter from CF_SSAI_ADSERVER_BASE_URL when set, wired to a real httpx
+    transport, so this is reachable outside of tests without every caller hand-rolling a
+    transport. Falls back to the fake when unset (e.g. local dev without ssaiadserver
+    running)."""
+    settings = get_settings()
+    if not settings.ssai_adserver_base_url:
+        return FakeSSAIAdapter()
+    return SsaiAdServerAdapter(settings.ssai_adserver_base_url, transport=_httpx_transport)
+
