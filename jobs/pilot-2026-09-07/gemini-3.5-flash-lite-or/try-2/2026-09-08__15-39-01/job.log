Sending keys: ['cat << \'EOF\' > packages/data-plane/src/avails.ts\nimport { parseMarkerLine } from "@ssai/core";\n\nexport interface Avail {\n  opportunityId: string;\n  channelId: string;\n  externalBreakId?: string;\n  duration: number;\n  declaredDuration?: number;\n  measuredDuration: number;\n  startSequence: number;\n  programDateTime?: string;\n  startLine: number;\n  endLine: number;\n}\n\nconst MEDIA_SEQUENCE = /^#EXT-X-MEDIA-SEQUENCE:(\\d+)/;\nconst EXTINF = /^#EXTINF:([\\d.]+)/;\nconst PROGRAM_DATE_TIME = /^#EXT-X-PROGRAM-DATE-TIME:(.+)/;\n\nexport function detectAvails(manifest: string, channelId: string): Avail[] {\n  const lines = manifest.split("\\n");\n\n  let mediaSequence = 0;\n  let lastPdt: string | undefined;\n  let blockBreakId: string | undefined;\n  const avails: Avail[] = [];\n\n  let open: {\n    startLine: number;\n    startSequence: number;\n    declaredDuration?: number;\n    measuredDuration: number;\n    pdt?: string;\n    externalBreakId?: string;\n  } | null = null;\n\n  let firstSeqInWindow: number | null = null;\n  let firstLineInWindow = 0;\n  let midBreakMeasured = 0;\n\n  for (let i = 0; i < lines.length; i++) {\n    const line = lines[i]!;\n    const trimmed = line.trim();\n\n    const seqMatch = trimmed.match(MEDIA_SEQUENCE);\n    if (seqMatch) {\n      mediaSequence = Number(seqMatch[1]);\n      continue;\n    }\n\n    const pdtMatch = trimmed.match(PROGRAM_DATE_TIME);\n    if (pdtMatch) {\n      lastPdt = pdtMatch[1]!.trim();\n      continue;\n    }\n\n    const marker = parseMarkerLine(line, i);\n    if (marker?.kind === "daterange" && marker.id) {\n      blockBreakId = marker.id;\n      if (open && open.externalBreakId === undefined) open.externalBreakId = marker.id;\n      continue;\n    }\n    if (marker?.kind === "cue_out" && !open) {\n      open = {\n        startLine: i,\n        startSequence: mediaSequence,\n        measuredDuration: 0,\n        ...(marker.duration === undefined ? {} : { declaredDuration: marker.duration }),\n        ...(lastPdt === undefined ? {} : { pdt: lastPdt }),\n        ...(blockBreakId === undefined ? {} : { externalBreakId: blockBreakId }),\n      };\n      firstSeqInWindow = null;\n      midBreakMeasured = 0;\n      continue;\n    }\n    if (marker?.kind === "cue_in") {\n      if (!open) {\n        const startSeq = firstSeqInWindow ?? mediaSequence;\n        open = {\n          startLine: firstLineInWindow,\n          startSequence: startSeq,\n          measuredDuration: midBreakMeasured,\n          ...(lastPdt === undefined ? {} : { pdt: lastPdt }),\n          ...(blockBreakId === undefined ? {} : { externalBreakId: blockBreakId }),\n        };\n      }\n      if (open) {\n        const declared = open.declaredDuration;\n        avails.push({\n          opportunityId: `opp_${channelId}_${open.startSequence}`,\n          channelId,\n          ...(open.externalBreakId === undefined ? {} : { externalBreakId: open.externalBreakId }),\n          duration: declared ?? open.measuredDuration,\n          ...(declared === undefined ? {} : { declaredDuration: declared }),\n          measuredDuration: open.measuredDuration,\n          startSequence: open.startSequence,\n          ...(open.pdt === undefined ? {} : { programDateTime: open.pdt }),\n          startLine: open.startLine,\n          endLine: i,\n        });\n        open = null;\n        firstSeqInWindow = null;\n        midBreakMeasured = 0;\n      }\n      continue;\n    }\n\n    const infMatch = trimmed.match(EXTINF);\n    if (infMatch) {\n      const segDur = Number(infMatch[1]);\n      if (open) {\n        open.measuredDuration += segDur;\n      } else {\n        midBreakMeasured += segDur;\n      }\n    } else if (trimmed.length > 0 && !trimmed.startsWith("#")) {\n      if (!open && firstSeqInWindow === null) {\n        firstSeqInWindow = mediaSequence;\n        firstLineInWindow = i - 1;\n      }\n      mediaSequence += 1;\n      blockBreakId = undefined;\n    }\n  }\n\n  return avails;\n}\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
