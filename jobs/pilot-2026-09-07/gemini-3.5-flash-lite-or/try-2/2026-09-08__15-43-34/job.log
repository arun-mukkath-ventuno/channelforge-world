Sending keys: ['cat << \'EOF\' > packages/persistence/src/repositories.test.ts\nimport { describe, it, expect, beforeEach } from "vitest";\nimport { readFileSync, readdirSync } from "node:fs";\nimport { fileURLToPath } from "node:url";\nimport { dirname, join, resolve } from "node:path";\nimport { newDb } from "pg-mem";\nimport type { Queryable } from "./db.js";\nimport { seedDatabase } from "./seed.js";\nimport { campaignsAsMap, listCampaigns } from "./repositories/campaigns.js";\nimport { listCreatives } from "./repositories/creatives.js";\nimport { ensureSession, getSession } from "./repositories/sessions.js";\nimport { upsertOpportunity } from "./repositories/opportunities.js";\nimport { saveDecision, getDecisionsBySession } from "./repositories/decisions.js";\nimport { appendEvent, getEventsBySession } from "./repositories/events.js";\nimport { decide, type AdOpportunity, type SessionContext } from "@ssai/core";\n\nconst here = dirname(fileURLToPath(import.meta.url));\nconst MIG_DIR = resolve(here, "../../../migrations");\nconst SCHEMA = readdirSync(MIG_DIR)\n  .filter((f) => f.endsWith(".sql"))\n  .sort()\n  .map((f) => readFileSync(join(MIG_DIR, f), "utf8"))\n  .join("\\n");\n\nfunction freshDb(): Queryable {\n  const mem = newDb();\n  mem.public.none(SCHEMA); // load full schema (multi-statement)\n  const { Pool } = mem.adapters.createPg();\n  return new Pool() as unknown as Queryable;\n}\n\nlet db: Queryable;\nbeforeEach(() => {\n  db = freshDb();\n});\n\ndescribe("seed + inventory repositories", () => {\n  it("seeds 5 channels and assembles campaign target channels", async () => {\n    await seedDatabase(db);\n    const campaigns = await listCampaigns(db);\n    const food = campaigns.find((c) => c.campaignId === "camp_food_a");\n    expect(food?.targetChannels).toEqual(["channel_food"]);\n    const appliance = campaigns.find((c) => c.campaignId === "camp_appliance_b");\n    expect(appliance?.targetChannels).toContain("channel_food");\n    expect(appliance?.targetChannels).toContain("channel_entertainment");\n  });\n\n  it("returns creatives with numeric duration/priority/weight", async () => {\n    await seedDatabase(db);\n    const creatives = await listCreatives(db);\n    const food30 = creatives.find((c) => c.creativeId === "cr_food_a_30");\n    expect(food30).toMatchObject({ duration: 30, priority: 10, weight: 100, status: "ready" });\n    expect(typeof food30!.duration).toBe("number");\n  });\n});\n\ndescribe("decision persistence round-trip (PRD §46, §47)", () => {\n  it("persists a decided pod and reads the full payload back", async () => {\n    await seedDatabase(db);\n    const creatives = await listCreatives(db);\n    const campaigns = await campaignsAsMap(db);\n\n    const opportunity: AdOpportunity = {\n      opportunityId: "opp_1",\n      channelId: "channel_food",\n      breakStart: "2026-08-29T12:15:00Z",\n      breakDuration: 60,\n      source: "cue_out",\n      signalType: "cue_out",\n    };\n    const session: SessionContext = { sessionId: "sess_1", channelId: "channel_food" };\n\n    const decision = decide({\n      opportunity,\n      session,\n      creatives,\n      campaigns,\n      now: "2026-08-29T12:15:00Z",\n      seed: "demo",\n    });\n\n    await ensureSession(db, { id: "sess_1", channelId: "channel_food", deviceType: "web", country: "IN" });\n    await upsertOpportunity(db, opportunity);\n    await saveDecision(db, {\n      decisionId: "dec_1",\n      podId: "pod_1",\n      decision,\n      requestedAt: "2026-08-29T12:15:00Z",\n      completedAt: "2026-08-29T12:15:00Z",\n    });\n\n    const stored = await getDecisionsBySession(db, "sess_1");\n    expect(stored).toHaveLength(1);\n    expect(stored[0]!.selectedCount).toBe(decision.pod.filter((p) => p.type === "ad").length);\n    // Full payload reconstructable (RL evaluation, PRD §56).\n    expect(stored[0]!.decision.pod).toEqual(decision.pod);\n    expect(stored[0]!.decision.breakDuration).toBe(60);\n\n    const sess = await getSession(db, "sess_1");\n    expect(sess).toMatchObject({ channelId: "channel_food", deviceType: "web", country: "IN" });\n  });\n});\n\ndescribe("event stream (PRD §26, §29, §30)", () => {\n  it("appends and reads events by session, ignoring duplicate event ids", async () => {\n    await seedDatabase(db);\n    await appendEvent(db, { eventId: "e1", eventType: "ad_impression", sessionId: "sess_1", adId: "cr_food_a_30" });\n    await appendEvent(db, { eventId: "e2", eventType: "ad_complete", sessionId: "sess_1", adId: "cr_food_a_30" });\n    await appendEvent(db, { eventId: "e1", eventType: "ad_impression", sessionId: "sess_1" }); // dup\n\n    const events = await getEventsBySession(db, "sess_1");\n    expect(events).toHaveLength(2);\n    expect(events.map((e) => e.eventType)).toEqual(["ad_impression", "ad_complete"]);\n  });\n});\n\ndescribe("session channel switching", () => {\n  it("updates session recorded channel when ensureSession is called with a new channel", async () => {\n    await seedDatabase(db);\n    await ensureSession(db, { id: "sess_switch", channelId: "channel_food" });\n    let sess = await getSession(db, "sess_switch");\n    expect(sess?.channelId).toBe("channel_food");\n\n    await ensureSession(db, { id: "sess_switch", channelId: "channel_yoga" });\n    sess = await getSession(db, "sess_switch");\n    expect(sess?.channelId).toBe("channel_yoga");\n  });\n});\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
