d = marker.id;\n      continue;\n    }\n    if (marker?.kind === "cue_out" && !open) {\n      sawCueInOrOut = true;\n      open = {\n        startLine: i,\n        startSequence: mediaSequence,\n        measuredDuration: 0,\n        ...(marker.duration === undefined ? {} : { declaredDuration: marker.duration }),\n        ...(lastPdt === undefined ? {} : { pdt: lastPdt }),\n        ...(blockBreakId === undefined ? {} : { externalBreakId: blockBreakId }),\n      };\n      continue;\n    }\n    if (marker?.kind === "cue_in") {\n      sawCueInOrOut = true;\n      if (open) {\n        const declared = open.declaredDuration;\n        avails.push({\n          opportunityId: `opp_${channelId}_${open.startSequence}`,\n          channelId,\n          ...(open.externalBreakId === undefined ? {} : { externalBreakId: open.externalBreakId }),\n          duration: declared ?? open.measuredDuration,\n          ...(declared === undefined ? {} : { declaredDuration: declared }),\n          measuredDuration: open.measuredDuration,\n          startSequence: open.startSequence,\n          ...(open.pdt === undefined ? {} : { programDateTime: open.pdt }),\n          startLine: open.startLine,\n          endLine: i,\n        });\n        open = null;\n        continue;\n      } else if (!open && leadingSegmentCount > 0) {\n        // Leading avail (mid-break tune-in: window started inside ad break)\n        const startSeq = mediaSequence - leadingSegmentCount;\n        avails.push({\n          opportunityId: `opp_${channelId}_${startSeq}`,\n          channelId,\n          ...(leadingBreakId === undefined ? {} : { externalBreakId: leadingBreakId }),\n          duration: leadingMeasuredDuration,\n          measuredDuration: leadingMeasuredDuration,\n          startSequence: startSeq,\n          ...(leadingPdt === undefined ? {} : { programDateTime: leadingPdt }),\n          startLine: 0,\n          endLine: i,\n        });\n        leadingSegmentCount = 0;\n        leadingMeasuredDuration = 0