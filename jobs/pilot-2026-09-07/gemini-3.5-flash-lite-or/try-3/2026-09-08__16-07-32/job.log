Sending keys: ['cat << \'EOF\' > packages/persistence/src/repositories/sessions.ts\n// Playback session repository (PRD §11, §12, §44).\n\nimport type { Queryable } from "../db.js";\nimport { toIso } from "../map.js";\n\nexport interface PlaybackSession {\n  id: string;\n  channelId: string;\n  createdAt: string;\n  lastActivityAt: string;\n  deviceType: string | null;\n  country: string | null;\n  anonymousId: string | null;\n}\n\ninterface SessionRow {\n  id: string;\n  channel_id: string;\n  created_at: unknown;\n  last_activity_at: unknown;\n  device_type: string | null;\n  country: string | null;\n  anonymous_id: string | null;\n}\n\nexport interface SessionInput {\n  id: string;\n  channelId: string;\n  deviceType?: string | null;\n  country?: string | null;\n  anonymousId?: string | null;\n  ipHash?: string | null;\n  userAgent?: string | null;\n}\n\n/** Create the session if absent; idempotent so ad-decision can ensure it exists. Updates channel_id if session switches channels. */\nexport async function ensureSession(db: Queryable, input: SessionInput): Promise<void> {\n  await db.query(\n    `INSERT INTO playback_sessions (id, channel_id, device_type, country, anonymous_id, ip_hash, user_agent)\n     VALUES ($1, $2, $3, $4, $5, $6, $7)\n     ON CONFLICT (id) DO UPDATE SET channel_id = EXCLUDED.channel_id`,\n    [\n      input.id,\n      input.channelId,\n      input.deviceType ?? null,\n      input.country ?? null,\n      input.anonymousId ?? null,\n      input.ipHash ?? null,\n      input.userAgent ?? null,\n    ],\n  );\n}\n\nexport async function touchSession(db: Queryable, id: string): Promise<void> {\n  await db.query(\n    "UPDATE playback_sessions SET last_activity_at = now() WHERE id = $1",\n    [id],\n  );\n}\n\nfunction toSession(r: SessionRow): PlaybackSession {\n  return {\n    id: r.id,\n    channelId: r.channel_id,\n    createdAt: toIso(r.created_at),\n    lastActivityAt: toIso(r.last_activity_at),\n    deviceType: r.device_type,\n    country: r.country,\n    anonymousId: r.anonymous_id,\n  };\n}\n\nexport async function getSession(\n  db: Queryable,\n  id: string,\n): Promise<PlaybackSession | null> {\n  const rows = (\n    await db.query<SessionRow>("SELECT * FROM playback_sessions WHERE id = $1", [\n      id,\n    ])\n  ).rows;\n  return rows[0] ? toSession(rows[0]) : null;\n}\n\nexport async function listSessions(\n  db: Queryable,\n  limit = 100,\n): Promise<PlaybackSession[]> {\n  const rows = (\n    await db.query<SessionRow>(\n      "SELECT * FROM playback_sessions ORDER BY last_activity_at DESC LIMIT $1",\n      [limit],\n    )\n  ).rows;\n  return rows.map(toSession);\n}\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
