Sending keys: ['cat << \'EOF\' > src/lib/ssai.ts\n// SSAI (server-side ad insertion) client — the AD leg of the Stream Telemetry Blueprint.\n//\n// For channels with an `ssaiChannel`, the player requests a session from the ad server, plays the\n// returned stitched `playback_url` (ChannelForge content + spliced ads), and fires per-ad quartile\n// beacons. This is SEPARATE from the audience telemetry in `telemetry-store` / `/api/fast/events`\n// (concurrents, QoE) — that stays untouched; ad events go to the SSAI\'s `/v1/events`.\n\nexport const SSAI_BASE = (\n  process.env.NEXT_PUBLIC_SSAI_BASE || "https://ssai.ventunotech.com"\n).replace(/\\$/, "");\n\nexport interface SsaiSession {\n  sessionId: string;\n  playbackUrl: string;\n}\n\n/** Create a playback session and get the stitched manifest URL for an SSAI channel. */\nexport async function createSsaiSession(ssaiChannel: string): Promise<SsaiSession | null> {\n  try {\n    const res = await fetch(`${SSAI_BASE}/v1/sessions`, {\n      method: "POST",\n      headers: { "Content-Type": "application/json" },\n      body: JSON.stringify({ channel_id: ssaiChannel }),\n    });\n    if (!res.ok) return null;\n    const d = await res.json();\n    if (!d?.session_id || !d?.playback_url) return null;\n    return { sessionId: String(d.session_id), playbackUrl: String(d.playback_url) };\n  } catch {\n    return null;\n  }\n}\n\nexport type AdBeacon =\n  | "ad_impression"\n  | "ad_start"\n  | "ad_first_quartile"\n  | "ad_midpoint"\n  | "ad_third_quartile"\n  | "ad_complete";\n\n/** Fire one ad tracking beacon to the SSAI. Best-effort; failures never disrupt playback. */\nexport function sendAdBeacon(sessionId: string, event: AdBeacon, adId: string, podId?: string): void {\n  const body = JSON.stringify({ event, session_id: sessionId, ad_id: adId, pod_id: podId });\n  try {\n    if (typeof navigator !== "undefined" && navigator.sendBeacon) {\n      navigator.sendBeacon(`${SSAI_BASE}/v1/events`, new Blob([body], { type: "application/json" }));\n    } else {\n      void fetch(`${SSAI_BASE}/v1/events`, {\n        method: "POST",\n        headers: { "Content-Type": "application/json" },\n        body,\n        keepalive: true,\n      });\n    }\n  } catch {\n    /* best-effort */\n  }\n}\n\nexport interface AdWindow {\n  adId: string;\n  start: number; // epoch ms\n  end: number; // epoch ms\n}\n\n/** Parse ad avails from a stitched media playlist\'s EXT-X-DATERANGE lines (CLASS com.fastworld.ad). */\nexport function parseAdWindows(manifest: string): AdWindow[] {\n  const out: AdWindow[] = [];\n  for (const line of manifest.split("\\n")) {\n    if (!line.startsWith("#EXT-X-DATERANGE:") || !line.includes(\'CLASS="com.fastworld.ad"\')) continue;\n    const attr = (k: string): string | undefined => line.match(new RegExp(`${k}="?([^",]+)"?`))?.[1];\n    const startDate = attr("START-DATE");\n    const dur = attr("DURATION");\n    const adId = attr("X-AD-ID") || attr("ID");\n    if (!startDate || !dur || !adId) continue;\n    const start = Date.parse(startDate);\n    const seconds = Number(dur);\n    if (Number.isNaN(start) || Number.isNaN(seconds)) continue;\n    out.push({ adId, start, end: start + seconds * 1000 });\n  }\n  return out;\n}\n\nexport interface ScteAvail {\n  id: string;\n  start: number; // epoch ms — break start (absolute, from START-DATE)\n  end: number; // epoch ms\n  durationSec: number;\n}\n\n/**\n * Parse SCTE-35 ad avails from a ChannelForge media playlist. These are the ad\n * OPPORTUNITIES the packager signals (where SSAI may splice), distinct from\n * `parseAdWindows` which reads the ads actually stitched in. Reads\n * `#EXT-X-DATERANGE` lines carrying `SCTE35-OUT` with an absolute `START-DATE`\n * and `PLANNED-DURATION`.\n */\nexport function parseScteAvails(manifest: string): ScteAvail[] {\n  const out: ScteAvail[] = [];\n  for (const line of manifest.split("\\n")) {\n    if (!line.startsWith("#EXT-X-DATERANGE:")) continue;\n    if (!/SCTE35-OUT/i.test(line)) continue;\n    const attr = (k: string): string | undefined =>\n      line.match(new RegExp(`${k}="?([^",]+)"?`))?.[1];\n    const startDate = attr("START-DATE");\n    const dur = attr("PLANNED-DURATION") || attr("DURATION");\n    const id = attr("ID") || "brk";\n    if (!startDate || !dur) continue;\n    const start = Date.parse(startDate);\n    const seconds = Number(dur);\n    if (Number.isNaN(start) || Number.isNaN(seconds)) continue;\n    out.push({ id, start, end: start + seconds * 1000, durationSec: seconds });\n  }\n  return out;\n}\n\n// Quartile thresholds → beacon. Fired at most once per (adId+start) window.\nconst QUARTILES: [number, AdBeacon][] = [\n  [0, "ad_impression"],\n  [0, "ad_start"],\n  [0.25, "ad_first_quartile"],\n  [0.5, "ad_midpoint"],\n  [0.75, "ad_third_quartile"],\n  [1, "ad_complete"],\n];\n\n/**\n * Watch the wall-clock playhead against the stitched manifest\'s ad windows and fire quartile\n * beacons as each ad plays. `playheadDate()` returns the current playhead as epoch ms (from\n * Shaka\'s getPlayheadTimeAsDate). Returns a stop() cleanup.\n */\nexport function startAdBeaconWatcher(opts: {\n  sessionId: string;\n  manifestUrl: string;\n  playheadDate: () => number | null;\n  refetchMs?: number;\n  tickMs?: number;\n}): () => void {\n  let windows: AdWindow[] = [];\n  const fired = new Set<string>(); // `${adId}:${start}:${beacon}`\n  let stopped = false;\n\n  async function refresh() {\n    try {\n      const res = await fetch(opts.manifestUrl, { cache: "no-store" });\n      if (res.ok) windows = parseAdWindows(await res.text());\n    } catch {\n      /* keep prior windows */\n    }\n  }\n\n  const tick = () => {\n    if (stopped) return;\n    const now = opts.playheadDate();\n    if (now != null) {\n      for (const w of windows) {\n        if (now < w.start || now > w.end) continue;\n        const progress = (now - w.start) / Math.max(1, w.end - w.start);\n        for (const [threshold, beacon] of QUARTILES) {\n          if (progress + 1e-6 < threshold) continue;\n          const key = `${w.adId}:${w.start}:${beacon}`;\n          if (fired.has(key)) continue;\n          fired.add(key);\n          sendAdBeacon(opts.sessionId, beacon, w.adId, String(w.start));\n        }\n      }\n    }\n  };\n\n  void refresh();\n  const refetch = setInterval(refresh, opts.refetchMs ?? 10_000);\n  const ticker = setInterval(tick, opts.tickMs ?? 1_000);\n  return () => {\n    stopped = true;\n    clearInterval(refetch);\n    clearInterval(ticker);\n  };\n}\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
