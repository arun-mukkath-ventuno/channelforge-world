Sending keys: ['cat > /tmp/avails_new.ts << \'PATCH_END\'\n// Avail detection over an origin media playlist (PRD §9, §22, §41).\n//\n// Walks the playlist, finds each CUE-OUT…CUE-IN region, and assigns a\n// *deterministic* opportunity id derived from the channel + the media sequence\n// of the avail\'s first segment. Determinism matters: every viewer\'s data-plane\n// request and the decisioning path must agree on the same opportunity id for a\n// given break without coordinating, so the cached pod is found on the hot path.\n\nimport { parseMarkerLine } from "@ssai/core";\n\nexport interface Avail {\n  opportunityId: string;\n  channelId: string;\n  /** The producer\'s stable break id, from the CUE-OUT\'s accompanying DATERANGE ID (ChannelForge\n   *  threads its break_id there). Undefined when the origin carried no DATERANGE ID. This is what\n   *  lets ChannelForge reconcile a delivery back to the exact planned break (its opportunityId,\n   *  by contrast, is a media-sequence-derived id independent of the producer). */\n  externalBreakId?: string;\n  /** Break duration: the marker\'s declared duration, or the summed segment time. */\n  duration: number;\n  /** Declared duration from the marker, if it carried a valid one. */\n  declaredDuration?: number;\n  /** Actual duration summed from the segments inside the avail. */\n  measuredDuration: number;\n  /** Media sequence number of the first segment inside the avail. */\n  startSequence: number;\n  programDateTime?: string;\n  /** Line index of the CUE-OUT marker. */\n  startLine: number;\n  /** Line index of the CUE-IN marker, or the last line of the manifest when the\n   *  playlist ends mid-break (a CUE-OUT with no CUE-IN in the window). */\n  endLine: number;\n}\n\nconst MEDIA_SEQUENCE = /^#EXT-X-MEDIA-SEQUENCE:(\\d+)/;\nconst EXTINF = /^#EXTINF:([\\d.]+)/;\nconst PROGRAM_DATE_TIME = /^#EXT-X-PROGRAM-DATE-TIME:(.+)/;\n\n/** Detect all avails in the manifest — both complete (CUE-OUT…CUE-IN) and the\n *  trailing mid-break case (CUE-OUT with no CUE-IN yet in the window). */\nexport function detectAvails(manifest: string, channelId: string): Avail[] {\n  const lines = manifest.split("\\n");\n\n  let mediaSequence = 0;\n  let lastPdt: string | undefined;\n  // The DATERANGE ID seen in the current segment\'s tag block, cleared at each segment boundary so\n  // one break\'s id never leaks onto the next. ChannelForge emits the CUE-OUT and its DATERANGE-OUT\n  // in the same block (CUE-OUT first), so this pairs them whichever order a producer uses.\n  let blockBreakId: string | undefined;\n  const avails: Avail[] = [];\n\n  // Pending avail state while we walk from CUE-OUT to CUE-IN.\n  let open: {\n    startLine: number;\n    startSequence: number;\n    declaredDuration?: number;\n    measuredDuration: number;\n    pdt?: string;\n    externalBreakId?: string;\n  } | null = null;\n\n  for (let i = 0; i < lines.length; i++) {\n    const line = lines[i]!;\n    const trimmed = line.trim();\n\n    const seqMatch = trimmed.match(MEDIA_SEQUENCE);\n    if (seqMatch) {\n      mediaSequence = Number(seqMatch[1]);\n      continue;\n    }\n\n    const pdtMatch = trimmed.match(PROGRAM_DATE_TIME);\n    if (pdtMatch) {\n      lastPdt = pdtMatch[1]!.trim();\n      // continue — PDT applies to the next segment.\n    }\n\n    const marker = parseMarkerLine(line, i);\n    if (marker?.kind === "daterange" && marker.id) {\n      blockBreakId = marker.id;\n      // DATERANGE-OUT typically follows the CUE-OUT in the same block; attach it to the open avail.\n      if (open && open.externalBreakId === undefined) open.externalBreakId = marker.id;\n      continue;\n    }\n    if (marker?.kind === "cue_out" && !open) {\n      open = {\n        startLine: i,\n        startSequence: mediaSequence,\n        measuredDuration: 0,\n        ...(marker.duration === undefined ? {} : { declaredDuration: marker.duration }),\n        ...(lastPdt === undefined ? {} : { pdt: lastPdt }),\n        // Covers a producer that emits DATERANGE before CUE-OUT within the same block.\n        ...(blockBreakId === undefined ? {} : { externalBreakId: blockBreakId }),\n      };\n      continue;\n    }\n    if (marker?.kind === "cue_in" && open) {\n      const declared = open.declaredDuration;\n      avails.push({\n        opportunityId: `opp_${channelId}_${open.startSequence}`,\n        channelId,\n        ...(open.externalBreakId === undefined ? {} : { externalBreakId: open.externalBreakId }),\n        duration: declared ?? open.measuredDuration,\n        ...(declared === undefined ? {} : { declaredDuration: declared }),\n        measuredDuration: open.measuredDuration,\n        startSequence: open.startSequence,\n        ...(open.pdt === undefined ? {} : { programDateTime: open.pdt }),\n        startLine: open.startLine,\n        endLine: i,\n      });\n      open = null;\n      continue;\n    }\n\n    // Count segments (an #EXTINF followed by a URI advances the media sequence).\n    const infMatch = trimmed.match(EXTINF);\n    if (infMatch) {\n      const segDur = Number(infMatch[1]);\n      if (open) open.measuredDuration += segDur;\n      // The URI line follows; advance the sequence when we consume it below.\n    } else if (trimmed.length > 0 && !trimmed.startsWith("#")) {\n      // A media segment URI line — the tag block ended, so a DATERANGE id does not carry over.\n      mediaSequence += 1;\n      blockBreakId = undefined;\n    }\n  }\n\n  // Mid-break: we walked off the end of the playlist mid-break (saw a CUE-OUT\n  // but never reached its CUE-IN). A session whose first manifest request for\n  // this break lands here — a fresh tune-in, a reconnect after a network blip,\n  // or a slow-to-poll client — must still get an ad for the rest of the break,\n  // otherwise it just gets the channel\'s default content for that stretch. Emit\n  // the trailing avail so the decider runs and a cached pod is honored.\n  if (open) {\n    const declared = open.declaredDuration;\n    avails.push({\n      opportunityId: `opp_${channelId}_${open.startSequence}`,\n      channelId,\n      ...(open.externalBreakId === undefined ? {} : { externalBreakId: open.externalBreakId }),\n      duration: declared ?? open.measuredDuration,\n      ...(declared === undefined ? {} : { declaredDuration: declared }),\n      measuredDuration: open.measuredDuration,\n      startSequence: open.startSequence,\n      ...(open.pdt === undefined ? {} : { programDateTime: open.pdt }),\n      startLine: open.startLine,\n      endLine: lines.length - 1,\n    });\n  }\n\n  return avails;\n}\nPATCH_END\nwc -l /tmp/avails_new.ts\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
