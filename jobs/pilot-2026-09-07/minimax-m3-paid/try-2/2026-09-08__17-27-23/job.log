Sending keys: ["cat > /tmp/ssai_patch.py << 'EOF'\nimport re\n\nwith open('/app/src/lib/ssai.ts', 'r') as f:\n    content = f.read()\n\n# Replace sendAdBeacon function to accept opportunityId and include event_id\nold_func = '''/** Fire one ad tracking beacon to the SSAI. Best-effort; failures never disrupt playback. */\nexport function sendAdBeacon(sessionId: string, event: AdBeacon, adId: string): void {\n  const body = JSON.stringify({ event, session_id: sessionId, ad_id: adId });'''\n\nnew_func = '''/** Fire one ad tracking beacon to the SSAI. Best-effort; failures never disrupt playback.\n *  `opportunityId` uniquely identifies this airing of the creative (e.g. the ad window's\n *  start epoch ms). It's folded into the event_id so two distinct airings of the same\n *  creative in the same session produce different ids and are both recorded, while\n *  genuine re-sends of the same beacon (e.g. after a manifest refresh) still dedup. */\nexport function sendAdBeacon(sessionId: string, event: AdBeacon, adId: string, opportunityId: string | number): void {\n  const eventId = `evt_${sessionId}_${opportunityId}_${adId}_${event}`;\n  const body = JSON.stringify({ event, event_id: eventId, session_id: sessionId, ad_id: adId, opportunity_id: String(opportunityId) });'''\n\ncontent = content.replace(old_func, new_func)\n\n# Replace the call site to pass w.start\nold_call = '''          sendAdBeacon(opts.sessionId, beacon, w.adId);'''\nnew_call = '''          sendAdBeacon(opts.sessionId, beacon, w.adId, w.start);'''\n\ncontent = content.replace(old_call, new_call)\n\nwith open('/app/src/lib/ssai.ts', 'w') as f:\n    f.write(content)\n\nprint('Patched successfully')\nEOF\npython3 /tmp/ssai_patch.py\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
