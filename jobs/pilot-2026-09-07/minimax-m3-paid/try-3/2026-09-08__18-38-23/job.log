xternalBreakId }),\n          duration: declared ?? open.measuredDuration,\n          ...(declared === undefined ? {} : { declaredDuration: declared }),\n          measuredDuration: open.measuredDuration,\n          startSequence: open.startSequence,\n          ...(open.pdt === undefined ? {} : { programDateTime: open.pdt }),\n          startLine: open.startLine,\n          endLine: i,\n        });\n        open = null;\n      } else if (measuredSinceLastCueIn > 0) {\n        // Late tune-in / reconnect mid-break: CUE-OUT scrolled out of the window, but a CUE-IN\n        // is present. Build an avail from the segments between the last CUE-IN (or window\n        // start) and this CUE-IN so the session gets an ad decision for the remaining break.\n        avails.push({\n          opportunityId: `opp_${channelId}_${windowStartSequence}`,\n          channelId,\n          duration: measuredSinceLastCueIn,\n          measuredDuration: measuredSinceLastCueIn,\n          startSequence: windowStartSequence,\n          startLine: lastCueInLine,\n          endLine: i,\n        });\n      }\n      measuredSinceLastCueIn = 0;\n      lastCueInLine = i + 1;\n      continue;\n    }\'\'\'\n\ncontent = content.replace(old_cue_in, new_cue_in)\n\n# Replace the EXTINF handling to also track measuredSinceLastCueIn\nold_extinf = \'\'\'    // Count segments (an #EXTINF followed by a URI advances the media sequence).\n    const infMatch = trimmed.match(EXTINF);\n    if (infMatch) {\n      const segDur = Number(infMatch[1]);\n      if (open) open.measuredDuration += segDur;\n      // The URI line follows; advance the sequence when we consume it below.\n    } else if (trimmed.length > 0 && !trimmed.startsWith("#")) {\n      // A media segment URI line — the tag block ended, so a DATERANGE id does not carry over.\n      mediaSequence += 1;\n      blockBreakId = undefined;\n    }\'\'\'\n\nnew_extinf = \'\'\'    // Count segments (an #EXTINF followed by a URI advances the media sequence).\n    