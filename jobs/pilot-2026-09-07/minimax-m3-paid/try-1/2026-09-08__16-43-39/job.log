Sending keys: ['python3 << \'PYEOF\'\ncontent = \'\'\'// Avail detection over an origin media playlist (PRD §9, §22, §41).\n//\n// Walks the playlist, finds each CUE-OUT...CUE-IN region, and assigns a\n// *deterministic* opportunity id derived from the channel + the media sequence\n// of the avail\'s first segment. Determinism matters: every viewer\'s data-plane\n// request and the decisioning path must agree on the same opportunity id for a\n// given break without coordinating, so the cached pod is found on the hot path.\n//\n// A session whose *first* manifest request for a given break lands after the\n// break has already been playing for a while may receive a manifest whose\n// CUE-OUT has already scrolled off the live window but whose CUE-IN is still\n// present (PRD §41). Such a window looks like the back end of a break without\n// its start marker. The detected avail must still be returned so the data\n// plane decides an ad for it; otherwise the session sees the origin slate for\n// the rest of the break and never shows up as having tried.\n\nimport { parseMarkerLine } from "@ssai/core";\n\nexport interface Avail {\n  opportunityId: string;\n  channelId: string;\n  /** The producer\'s stable break id, from the CUE-OUT\'s accompanying DATERANGE ID (ChannelForge\n   *  threads its break_id there). Undefined when the origin carried no DATERANGE ID. This is what\n   *  lets ChannelForge reconcile a delivery back to the exact planned break (its opportunityId,\n   *  by contrast, is a media-sequence-derived id independent of the producer). */\n  externalBreakId?: string;\n  /** Break duration: the marker\'s declared duration, or the summed segment time. */\n  duration: number;\n  /** Declared duration from the marker, if it carried a valid one. */\n  declaredDuration?: number;\n  /** Actual duration summed from the segments inside the avail. */\n  measuredDuration: number;\n  /** Media sequence number of the first segment inside the avail. */\n  startSequence: number;\n  programDateTime?: string;\n  /** Line index of the CUE-OUT marker, or of the first segment of a synthetic avail\n   *  synthesized when the CUE-OUT has scrolled off but the CUE-IN is still in the window. */\n  startLine: number;\n  /** Line index of the CUE-IN marker. */\n  endLine: number;\n}\n\nconst MEDIA_SEQUENCE = /^#EXT-X-MEDIA-SEQUENCE:(\\\\d+)/;\nconst EXTINF = /^#EXTINF:([\\\\d.]+)/;\nconst PROGRAM_DATE_TIME = /^#EXT-X-PROGRAM-DATE-TIME:(.+)/;\n\n/** Detect all complete avails in the manifest. Incomplete trailing avails (a\n *  CUE-OUT with no CUE-IN yet in the window) are ignored - PRD §41.\n *\n *  Symmetrically, a manifest whose CUE-IN is present but whose CUE-OUT has\n *  already scrolled off the live window is the back of an in-progress break.\n *  Such a window is synthesized into an avail anchored on the first visible\n *  segment so a freshly-tuned-in session still gets a decision for the rest\n *  of the break. */\nexport function detectAvails(manifest: string, channelId: string): Avail[] {\n  const lines = manifest.split("\\\\n");\n\n  let mediaSequence = 0;\n  let lastPdt: string | undefined;\n  // The DATERANGE ID seen in the current segment\'s tag block, cleared at each segment boundary so\n  // one break\'s id never leaks onto the next. ChannelForge emits the CUE-OUT and its DATERANGE-OUT\n  // in the same block (CUE-OUT first), so this pairs them whichever order a producer uses.\n  let blockBreakId: string | undefined;\n  const avails: Avail[] = [];\n\n  // Pending avail state while we walk from CUE-OUT to CUE-IN.\n  let open: {\n    startLine: number;\n    startSequence: number;\n    declaredDuration?: number;\n    measuredDuration: number;\n    pdt?: string;\n    externalBreakId?: string;\n  } | null = null;\n\n  // Synthetic avail state when we see a CUE-IN without a preceding CUE-OUT:\n  // the break started earlier in the live window and its CUE-OUT has scrolled\n  // off, but the break is still in progress (the CUE-IN has just been emitted).\n  // We synthesize an avail anchored on the first visible inside-avail segment.\n  let orphan: {\n    startLine: number;\n    startSequence: number;\n    measuredDuration: number;\n    pdt?: string;\n    externalBreakId?: string;\n  } | null = null;\n\n  for (let i = 0; i < lines.length; i++) {\n    const line = lines[i]!;\n    const trimmed = line.trim();\n\n    const seqMatch = trimmed.match(MEDIA_SEQUENCE);\n    if (seqMatch) {\n      mediaSequence = Number(seqMatch[1]);\n      continue;\n    }\n\n    const pdtMatch = trimmed.match(PROGRAM_DATE_TIME);\n    if (pdtMatch) {\n      lastPdt = pdtMatch[1]!.trim();\n      // continue - PDT applies to the next segment.\n    }\n\n    const marker = parseMarkerLine(line, i);\n    if (marker?.kind === "daterange" && marker.id) {\n      blockBreakId = marker.id;\n      // DATERANGE-OUT typically follows the CUE-OUT in the same block; attach it to the open avail.\n      if (open && open.externalBreakId === undefined) open.externalBreakId = marker.id;\n      // Also attach to a synthetic (orphan) avail if the DATERANGE happens to\n      // still be in the window for an in-progress break whose CUE-OUT scrolled off.\n      if (orphan && orphan.externalBreakId === undefined) orphan.externalBreakId = marker.id;\n      continue;\n    }\n    if (marker?.kind === "cue_out" && !open) {\n      // If we were tracking a synthetic avail for the same break, it has now\n      // been confirmed by the CUE-OUT arriving; collapse to the normal path\n      // so subsequent CUE-IN closes it cleanly with the CUE-OUT-anchored id.\n      if (orphan) orphan = null;\n      open = {\n        startLine: i,\n        startSequence: mediaSequence,\n        measuredDuration: 0,\n        ...(marker.duration === undefined ? {} : { declaredDuration: marker.duration }),\n        ...(lastPdt === undefined ? {} : { pdt: lastPdt }),\n        // Covers a producer that emits DATERANGE before CUE-OUT within the same block.\n        ...(blockBreakId === undefined ? {} : { externalBreakId: blockBreakId }),\n      };\n      continue;\n    }\n    if (marker?.kind === "cue_in" && open) {\n      const declared = open.declaredDuration;\n      avails.push({\n        opportunityId: `opp_${channelId}_${open.startSequence}`,\n        channelId,\n        ...(open.externalBreakId === undefined ? {} : { externalBreakId: open.externalBreakId }),\n        duration: declared ?? open.measuredDuration,\n        ...(declared === undefined ? {} : { declaredDuration: declared }),\n        measuredDuration: open.measuredDuration,\n        startSequence: open.startSequence,\n        ...(open.pdt === undefined ? {} : { programDateTime: open.pdt }),\n        startLine: open.startLine,\n        endLine: i,\n      });\n      open = null;\n      continue;\n    }\n    if (marker?.kind === "cue_in" && !open && orphan) {\n      // CUE-IN without a preceding CUE-OUT: we have a synthetic (orphan) avail\n      // for the in-progress break. Close it at the CUE-IN so the stitcher can\n      // replace the remaining inside-avail segments with the decided pod.\n      const extId = orphan.externalBreakId;\n      avails.push({\n        // When the producer\'s stable DATERANGE id is available, key the\n        // opportunity on it - that id is the same across viewers who connect\n        // at different points in the same break, so a session that was already\n        // decided for this break can reuse its cached pod on reconnect.\n        // Otherwise fall back to the first visible inside-avail segment\'s media\n        // sequence (deterministic for this window, same scheme as before).\n        opportunityId: extId ? `opp_${channelId}_${extId}` : `opp_${channelId}_${orphan.startSequence}`,\n        channelId,\n        ...(extId === undefined ? {} : { externalBreakId: extId }),\n        duration: orphan.measuredDuration,\n        measuredDuration: orphan.measuredDuration,\n        startSequence: orphan.startSequence,\n        ...(orphan.pdt === undefined ? {} : { programDateTime: orphan.pdt }),\n        startLine: orphan.startLine,\n        endLine: i,\n      });\n      orphan = null;\n      continue;\n    }\n\n    // Count segments (an #EXTINF followed by a URI advances the media sequence).\n    const infMatch = trimmed.match(EXTINF);\n    if (infMatch) {\n      const segDur = Number(infMatch[1]);\n      if (open) open.measuredDuration += segDur;\n      // The URI line follows; advance the sequence when we consume it below.\n    } else if (trimmed.length > 0 && !trimmed.startsWith("#")) {\n      // A media segment URI line - the tag block ended, so a DATERANGE id does not carry over.\n      mediaSequence += 1;\n      blockBreakId = undefined;\n      // If no CUE-OUT is open but we are accumulating segments before a CUE-IN,\n      // we are inside an in-progress break whose CUE-OUT scrolled off. Start\n      // tracking a synthetic avail on the first such segment.\n      if (!open && !orphan && mediaSequence > 0) {\n        orphan = {\n          startLine: i - 1 >= 0 ? i - 1 : i,\n          startSequence: mediaSequence - 1,\n          measuredDuration: 0,\n          ...(lastPdt === undefined ? {} : { pdt: lastPdt }),\n        };\n      }\n    }\n  }\n\n  return avails;\n}\n\'\'\'\nwith open(\'packages/data-plane/src/avails.ts\', \'w\') as f:\n    f.write(content)\nprint(\'Written\')\nPYEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
